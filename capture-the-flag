const server = http.createServer((req, res) => {
  if (req.method === 'GET' && req.url === '/api/challenges') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    const safeList = challenges.map(c => ({ id: c.id, category: c.category, title: c.title, prompt: c.prompt }));
    res.end(JSON.stringify(safeList));
  } 
  else if (req.method === 'GET' && req.url === '/api/scoreboard') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify(scoreboard));
  }
  else if (req.method === 'POST' && req.url === '/api/submit') {
    let body = '';
    req.on('data', chunk => { body += chunk; });
    req.on('end', () => {
      try {
        const { username, id, flag, elapsedSeconds } = JSON.parse(body);
        const name = username ? username.trim() : "Anonymous";
        
        if (!scoreboard[name]) scoreboard[name] = 0;

        const challenge = challenges.find(c => c.id === id);
        if (!challenge) {
          res.writeHead(404, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ success: false, message: "Challenge not found." }));
          return;
        }

        if (challenge.flag.trim().toLowerCase() === flag.trim().toLowerCase()) {
          let points = 10;
          let bonusMessage = "Base Points: 10";
          if (elapsedSeconds <= 300) { points += 1; bonusMessage += " + 1 Speed Bonus! ⚡"; }
          else if (elapsedSeconds > 300) { points -= 1; bonusMessage += " - 1 Time Penalty ⏰"; }

          scoreboard[name] += points;

          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ success: true, points, message: `Correct! ${bonusMessage}` }));
        } else {
          scoreboard[name] = Math.max(0, scoreboard[name] - 2);
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ success: false, message: "Incorrect flag! -10 Points penalty." }));
        }
      } catch (err) {
        res.writeHead(400, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ success: false, message: "Invalid request format." }));
      }
    });
  } 
  else {
    let urlPath = req.url === '/' ? 'index.html' : req.url;
    let filePath = path.join(__dirname, 'public', urlPath);
    let extname = path.extname(filePath);
    let contentType = 'text/html';
    if (extname === '.js') contentType = 'text/javascript';
    else if (extname === '.css') contentType = 'text/css';

    fs.readFile(filePath, (err, content) => {
      if (err) {
        res.writeHead(404, { 'Content-Type': 'text/plain' });
        res.end('404 Not Found');
      } else {
        res.writeHead(200, { 'Content-Type': contentType });
        res.end(content, 'utf-8');
      }
    });
  }
});

